# ~/ts-data/.env 로 복사해서 값 채우기 (git에 올리지 않기, chmod 600)
MQTT_HOST=브로커주소
MQTT_PORT=1883
MQTT_USER=아이디
MQTT_PASS=비밀번호
# 센서 업링크 구독 토픽 (ChirpStack 기본 형식 예: application/<앱ID>/device/+/event/up)
SUB_TOPIC=application/+/device/+/event/up
DB_FILE=live.db
CLIENT_ID=ts-team4-collector
PUB_PREFIX=ts-team4/inference
API_PORT=8425
